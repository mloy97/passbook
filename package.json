{
	"name": "passbook",
	"version": "0.1.0",
	"description": "Obsidian plugin: bank and credit card data in your vault, in a stable, documented format",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test:e2e": "tsc -noEmit -p tests/e2e && npm run build && node -e \"require('fs').mkdirSync('screenshots',{recursive:true})\" && wdio run ./wdio.conf.mts"
	},
	"license": "Apache-2.0",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.20.5",
		"@wdio/cli": "^9.32.0",
		"@wdio/globals": "^9.31.3",
		"@wdio/local-runner": "^9.32.0",
		"@wdio/mocha-framework": "^9.32.0",
		"@wdio/spec-reporter": "^9.32.0",
		"esbuild": "^0.27.7",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"mocha": "^10.8.2",
		"obsidian": "^1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1",
		"vitest": "^5.0.3",
		"wdio-obsidian-reporter": "^3.3.0",
		"wdio-obsidian-service": "^3.3.0"
	}
}
